#include <iostream>
#include <string>

using namespace std;

struct Student {
    int rollNumber;
    string name;
    float gpa;
    Student* next;
};

class StudentManagement {
private:
    Student* head;

public:
    StudentManagement() { head = nullptr; }

    void addStudent(int roll, string n, float g) {
        Student* newStudent = new Student();
        newStudent->rollNumber = roll;
        newStudent->name = n;
        newStudent->gpa = g;
        newStudent->next = head;
        head = newStudent;
        cout << "Student added successfully!\n";
    }

    void displayStudents() {
        if (head == nullptr) {
            cout << "List is empty.\n";
            return;
        }
        Student* temp = head;
        cout << "\n--- Student Records ---\n";
        while (temp != nullptr) {
            cout << "Roll: " << temp->rollNumber << " | Name: " << temp->name << " | GPA: " << temp->gpa << endl;
            temp = temp->next;
        }
    }

    void searchStudent(int roll) {
        Student* temp = head;
        while (temp != nullptr) {
            if (temp->rollNumber == roll) {
                cout << "Student Found: " << temp->name << " (GPA: " << temp->gpa << ")\n";
                return;
            }
            temp = temp->next;
        }
        cout << "Student with Roll " << roll << " not found.\n";
    }

    void deleteStudent(int roll) {
        if (head == nullptr) return;

        if (head->rollNumber == roll) {
            Student* temp = head;
            head = head->next;
            delete temp;
            cout << "Record deleted.\n";
            return;
        }

        Student* current = head;
        Student* prev = nullptr;

        while (current != nullptr && current->rollNumber != roll) {
            prev = current;
            current = current->next;
        }

        if (current == nullptr) {
            cout << "Record not found.\n";
            return;
        }

        prev->next = current->next;
        delete current;
        cout << "Record deleted.\n";
    }

    ~StudentManagement() {
        while (head != nullptr) {
            Student* temp = head;
            head = head->next;
            delete temp;
        }
    }
};

int main() {
    StudentManagement sms;
    int choice, roll;
    string name;
    float gpa;

    while (true) {
        cout << "\n1. Add Student\n2. Display All\n3. Search\n4. Delete\n5. Exit\nEnter Choice: ";
        cin >> choice;

        if (choice == 1) {
            cout << "Enter Roll: "; cin >> roll;
            cout << "Enter Name: "; cin.ignore(); getline(cin, name);
            cout << "Enter GPA: "; cin >> gpa;
            sms.addStudent(roll, name, gpa);
        } else if (choice == 2) {
            sms.displayStudents();
        } else if (choice == 3) {
            cout << "Enter Roll to Search: "; cin >> roll;
            sms.searchStudent(roll);
        } else if (choice == 4) {
            cout << "Enter Roll to Delete: "; cin >> roll;
            sms.deleteStudent(roll);
        } else if (choice == 5) {
            break;
        } else {
            cout << "Invalid choice!\n";
        }
    }
    return 0;
}
